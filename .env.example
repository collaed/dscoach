# DSCoaching — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://coaching:coaching@127.0.0.1:5432/coaching

# Flask
SECRET_KEY=change-me-in-production

# AI Backends
HETZNER_API_KEY=
HETZNER_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
AI_BACKEND=hetzner

# Cloudflare (fallback)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Media
ATTACHMENTS_DIR=/data/attachments
